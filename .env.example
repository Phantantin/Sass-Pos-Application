SERVER_PORT=5000
DB_URL=jdbc:mysql://localhost:3306/sass_pos_db
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=8400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
